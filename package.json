    "react-dom": "19.2.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.8.0",
    "@tailwindcss/postcss": "^4",
    "@types/babel__generator": "^7.27.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.5.3",
    "prettier": "^3.8.1",
